# GCP Vertex AI 설정
# .env로 복사 후 실제 값 입력. .env는 git에 올리지 않음.

GCP_PROJECT_ID=your-project-id-here
GCP_REGION=asia-northeast3

# 인증 방법 1: service account key 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# 인증 방법 2: gcloud CLI 로그인 사용 시 위 변수는 비워둬도 됨
# gcloud auth application-default login

# 모델 설정 (config/defaults.py에서 기본값 정의됨, 여기서 오버라이드 가능)
GEMINI_MODEL_HEAVY=gemini-2.5-pro
GEMINI_MODEL_LIGHT=gemini-2.5-flash

# 비용 추적용 (선택)
ENABLE_USAGE_LOGGING=true
